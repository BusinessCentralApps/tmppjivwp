{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go/95f863f555d65db71653b7e379eafa3104aafa79/Actions/.Modules/settings.schema.json",
  "templateUrl": "https://github.com/businesscentralapps/tmp5KSkvc-PTE@main",
  "conditionalSettings": [
    {
      "workflows": [
        "CI/CD"
      ],
      "settings": {
        "workflowConcurrency": [
          "group: ${{ github.workflow }}-${{ github.ref }}",
          "cancel-in-progress: true"
        ]
      }
    }
  ],
  "githubRunnerShell": "powershell",
  "useCompilerFolder": true,
  "MicrosoftTelemetryConnectionString": "",
  "doNotPublishApps": true,
  "type": "PTE",
  "incrementalBuilds": {
    "onPush": true
  },
  "useApproximateVersion": true,
  "UseProjectDependencies": true,
  "githubRunner": "windows-latest",
  "templateSha": "668af2512ba256d84c51ff3f3f83520132cfbc5b"
}
